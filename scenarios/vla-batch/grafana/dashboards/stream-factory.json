{
  "uid": "stream-factory",
  "title": "DairyWorks — live process",
  "description": "The vla plant as the historian sees it: cooking, quality and OEE for both lines. Shown in the YouTube livestream; shared publicly, so TDengine only and no variables.",
  "tags": [
    "stream"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "links": [],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Line 1 · batch step",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Table",
          "sql": "select last(`valuestr`) as step from idp.telemetry where `topic`='DairyWorks/Vla/Batch/Status/state'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "IDLE": {
                  "text": "idle",
                  "index": 0
                },
                "DOSING": {
                  "text": "dosing",
                  "index": 1
                },
                "COOKING": {
                  "text": "cooking",
                  "index": 2
                },
                "COOLING": {
                  "text": "cooling",
                  "index": 3
                },
                "FILLING": {
                  "text": "filling",
                  "index": 4
                },
                "COMPLETE": {
                  "text": "complete",
                  "index": 5
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      }
    },
