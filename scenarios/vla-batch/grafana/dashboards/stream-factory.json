    {
      "id": 7,
      "type": "timeseries",
      "title": "Cook temperature (pasteurising)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, avg(`value`) as line_1 from idp.telemetry where `topic`='DairyWorks/Vla/Cook/cook-unit-01/Status/temp_C' and _ts >= $from and _ts <= $to interval(30s) fill(prev)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, avg(`value`) as line_2 from idp.telemetry where `topic`='DairyWorks/Vla-L2/Cook/cook-unit-02/Status/temp_C' and _ts >= $from and _ts <= $to interval(30s) fill(prev)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "spanNulls": true,
            "showPoints": "never"
          },
          "unit": "celsius"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      },
      "description": "Heated to the recipe setpoint and held: the starch gelatinises and the product is pasteurised."
    },
