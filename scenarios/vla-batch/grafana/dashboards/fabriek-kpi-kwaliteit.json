          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Table",
          "sql": "select sum(case when `input`='units_defective' then `value` else 0.0 end) / sum(case when `input`='units_inspected' then `value` else 0.0 end) * 100 as v from idp.kpi_input where kpi_id='KPI-QUA-001' and `line`='$lijn' and ts >= $from and ts < $to"
