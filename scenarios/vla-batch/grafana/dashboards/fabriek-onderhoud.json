        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "rowHeight": 0.8,
        "alignValue": "center",
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
