          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`value`) as mixing from idp.telemetry where `topic` like 'DairyWorks/$lijn/Mixing/%/Status/running_hours' and _ts >= $from and _ts <= $to interval(5m) fill(prev)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`value`) as cook from idp.telemetry where `topic` like 'DairyWorks/$lijn/Cook/%/Status/running_hours' and _ts >= $from and _ts <= $to interval(5m) fill(prev)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`value`) as cooling from idp.telemetry where `topic` like 'DairyWorks/$lijn/Cooling/%/Status/running_hours' and _ts >= $from and _ts <= $to interval(5m) fill(prev)"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`value`) as filling from idp.telemetry where `topic` like 'DairyWorks/$lijn/Filling/%/Status/running_hours' and _ts >= $from and _ts <= $to interval(5m) fill(prev)"
        }
