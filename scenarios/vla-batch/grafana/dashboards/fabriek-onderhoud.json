          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`value`) as receiving from idp.telemetry where `topic` like 'DairyWorks/$lijn/Receiving/%/Status/running_hours' and _ts >= $from and _ts <= $to interval(5m) fill(prev)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
