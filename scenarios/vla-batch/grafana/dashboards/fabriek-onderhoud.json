      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Draaiuren",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
