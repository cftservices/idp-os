    {
      "id": 3,
      "type": "timeseries",
      "title": "Vervuilingsalarm kookunit",
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, count(*) as alarmen from idp.telemetry where `topic` like 'DairyWorks/$lijn/Cook/%/Alert/fouling_heatup' and _ts >= $from and _ts <= $to interval(1h)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60
          },
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      },
      "description": "Aantal vervuilingsmeldingen per uur: de opwarmtijd overschrijdt de CBM-grens, CIP plannen."
    },
