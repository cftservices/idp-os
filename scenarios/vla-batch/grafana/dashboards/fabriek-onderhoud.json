  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "Onderhoudstoestand per machine",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`valuestr`) as receiving from idp.telemetry where `topic` like 'DairyWorks/$lijn/Receiving/%/Status/maintenance_state' and _ts >= $from and _ts <= $to interval(1m) fill(prev)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`valuestr`) as mixing from idp.telemetry where `topic` like 'DairyWorks/$lijn/Mixing/%/Status/maintenance_state' and _ts >= $from and _ts <= $to interval(1m) fill(prev)"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`valuestr`) as cook from idp.telemetry where `topic` like 'DairyWorks/$lijn/Cook/%/Status/maintenance_state' and _ts >= $from and _ts <= $to interval(1m) fill(prev)"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`valuestr`) as cooling from idp.telemetry where `topic` like 'DairyWorks/$lijn/Cooling/%/Status/maintenance_state' and _ts >= $from and _ts <= $to interval(1m) fill(prev)"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`valuestr`) as filling from idp.telemetry where `topic` like 'DairyWorks/$lijn/Filling/%/Status/maintenance_state' and _ts >= $from and _ts <= $to interval(1m) fill(prev)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
