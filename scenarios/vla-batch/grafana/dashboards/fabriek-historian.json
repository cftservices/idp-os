    {
      "id": 9,
      "type": "table",
      "title": "Databases in de historian",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Table",
          "sql": "select create_time as aangemaakt, name as db, ntables as tabellen, `keep` as bewaartermijn, `vgroups` as vgroepen from information_schema.ins_databases where name not in ('information_schema','performance_schema','log')"
        }
