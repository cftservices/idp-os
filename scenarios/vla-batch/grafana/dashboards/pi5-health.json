{
  "uid": "pi5-health",
  "title": "Pi 5 — health",
  "description": "The Raspberry Pi 5 behind the livestream: temperature, throttling, power, fan, CPU, memory and the stream itself. Measured on the Pi every minute.",
  "tags": [
    "pi5"
  ],
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": []
  },
  "links": [],
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "targets": [],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "mode": "markdown",
        "content": "This Raspberry Pi 5 renders the 3D twin and encodes the stream, measured on the Pi every minute. **Heat:** above 80 °C the Pi starts to slow its clock down, at 85 °C for real; the clock then drops below 2400 MHz and the picture stutters. **Undervoltage** means the power supply is too weak (a Pi 5 wants 5 V / 5 A). Pi 5, 8 GB, active cooler."
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last reading",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Table",
          "sql": "select cast((cast(now() as bigint) - cast(last(ts) as bigint)) / 1000 as bigint) as `seconds_ago` from idp.pi_host where ts > now-1d"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 180
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "wideLayout": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      },
      "description": "Age of the last reading from the Pi. Red: the Pi is off, offline, or its cron job stopped."
    },
