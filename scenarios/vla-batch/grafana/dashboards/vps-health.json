    {
      "id": 16,
      "type": "timeseries",
      "title": "CPU",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, avg(cpu_user) as gebruiker, avg(cpu_system) as systeem, avg(cpu_iowait) as io_wacht, avg(cpu_steal) as steal from idp.vps_host where ts >= $from and ts <= $to interval(1m) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 40,
            "spanNulls": true,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "steal"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "datasource": {
        "type": "tdengine-datasource",
        "uid": "vla-tdengine"
      },
      "description": "Gestapeld: wat er boven ligt is vrij. Rood is steal."
