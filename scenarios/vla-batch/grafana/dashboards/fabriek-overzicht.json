        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
          "formatType": "Time series",
          "sql": "select _wstart as ts, last(`valuestr`) as lijn_1 from idp.telemetry where `topic`='DairyWorks/Vla/Batch/Status/state' and _ts >= $from and _ts <= $to interval(10s) fill(prev)"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "tdengine-datasource",
            "uid": "vla-tdengine"
          },
          "queryType": "SQL",
