{
  "schema_version": "1.0",
  "title": "Het 30-signalen-sjabloon voor lijn Vla-B",
  "purpose": "Elke machine in het park heeft exact deze 30 slots. Alleen groep B (procesvariabelen) verschilt per machine; die namen komen uit `park.pvs` van het work center in isa95-vla.json. Alle andere 22 slots zijn identiek over alle machines. Dat is wat generatie mogelijk maakt: 12 x 30 = 360 signalen zonder 360 handgeschreven definities, en een Grafana-rij die je een keer ontwerpt.",
  "anonymization": "Generieke fabriek 'DairyWorks'. Geen echte klant-, werkgever- of leveranciersnamen, IP's of schema's.",

  "sampling_classes": {
    "fast": { "interval_ms": 1000, "note": "Alleen voor procesvariabelen waar een storing binnen seconden zichtbaar moet zijn." },
    "normal": { "interval_ms": 5000, "note": "De standaard. Traag genoeg voor 2 vCPU, snel genoeg voor een demo." },
    "slow": { "interval_ms": 30000, "note": "Tellers en langzame CBM-grootheden. Ook de hartslag van de .Q-companions." },
    "onchange": { "interval_ms": null, "note": "Publiceert alleen bij verandering, plus een keepalive van 60 s zodat stilte niet met stale wordt verward." }
  },

  "keepalive_s": 60,

  "quality_companion": {
    "suffix": ".Q",
    "applies_to_profiles": ["vendor-a", "vendor-c"],
    "sampling_class": "slow",
    "why_not_onchange": "Een constant DA-qualityword publiceert bij onchange precies een keer. Een conditioner die daarna herstart heeft dan nooit kwaliteit gezien en zet alles op UNCERTAIN. Met een hartslag van 30 s is de opstartvolgorde irrelevant. Dit is een echte fout uit de run van 3 augustus."
  },

  "groups": {
    "A": "identiteit en toestand",
    "B": "procesvariabelen (machinespecifiek)",
    "C": "setpoints (schrijfbaar)",
    "D": "actuatoren",
    "E": "tellers",
    "F": "health en CBM",
    "G": "alarmwoord"
  },

  "slots": [
    {
      "slot": 1, "group": "A", "name": "StateCurrent",
      "display_name": "PackML-toestand", "datatype": "Int32", "unit": "",
      "writable": false, "sampling_class": "onchange", "deadband": 0,
      "source": "state_machine.current.value",
      "normal_range": { "min": 1, "max": 17 }
    },
    {
      "slot": 2, "group": "A", "name": "StateCurrentStr",
      "display_name": "Toestand (tekst)", "datatype": "String", "unit": "",
      "writable": false, "sampling_class": "onchange", "deadband": null,
      "source": "state_machine.current.name"
    },
    {
      "slot": 3, "group": "A", "name": "UnitMode",
      "display_name": "Bedrijfsmodus", "datatype": "Int32", "unit": "",
      "writable": false, "sampling_class": "onchange", "deadband": 0,
      "source": "state_machine.unit_mode",
      "enum": { "1": "Production", "2": "Maintenance", "3": "Manual" }
    },
    {
      "slot": 4, "group": "A", "name": "MachSpeed",
      "display_name": "Ontwerpsnelheid", "datatype": "Double", "unit": "u/min",
      "writable": false, "sampling_class": "onchange", "deadband": 0.5,
      "source": "state_machine.mach_speed"
    },
    {
      "slot": 5, "group": "A", "name": "CurMachSpeed",
      "display_name": "Actuele snelheid", "datatype": "Double", "unit": "u/min",
      "writable": false, "sampling_class": "normal", "deadband": 0.5,
      "source": "state_machine.cur_mach_speed"
    },

    { "slot": 6,  "group": "B", "pv_index": 0, "machine_specific": true, "sampling_class": "fast",   "writable": false },
    { "slot": 7,  "group": "B", "pv_index": 1, "machine_specific": true, "sampling_class": "fast",   "writable": false },
    { "slot": 8,  "group": "B", "pv_index": 2, "machine_specific": true, "sampling_class": "fast",   "writable": false },
    { "slot": 9,  "group": "B", "pv_index": 3, "machine_specific": true, "sampling_class": "fast",   "writable": false },
    { "slot": 10, "group": "B", "pv_index": 4, "machine_specific": true, "sampling_class": "normal", "writable": false },
    { "slot": 11, "group": "B", "pv_index": 5, "machine_specific": true, "sampling_class": "normal", "writable": false },
    { "slot": 12, "group": "B", "pv_index": 6, "machine_specific": true, "sampling_class": "normal", "writable": false },
    { "slot": 13, "group": "B", "pv_index": 7, "machine_specific": true, "sampling_class": "normal", "writable": false },

    {
      "slot": 14, "group": "C", "name": "sp_primary",
      "display_name": "Setpoint primair", "datatype": "Double",
      "unit_from": "pv_index:0",
      "writable": true, "sampling_class": "onchange", "deadband": 0,
      "source": "physics.sp_primary",
      "note": "Neemt de eenheid over van de eerste procesvariabele. Target en actual horen altijd als paar te bestaan; dat is canon 06-Model B.2b en precies wat op lijn Vla vier tags lang mis is gegaan."
    },
    {
      "slot": 15, "group": "C", "name": "sp_secondary",
      "display_name": "Setpoint secundair", "datatype": "Double",
      "unit_from": "pv_index:1",
      "writable": true, "sampling_class": "onchange", "deadband": 0,
      "source": "physics.sp_secondary"
    },
    {
      "slot": 16, "group": "C", "name": "sp_speed_pct",
      "display_name": "Snelheids-setpoint", "datatype": "Double", "unit": "%",
      "writable": true, "sampling_class": "onchange", "deadband": 0,
      "source": "state_machine.speed_setpoint_pct",
      "normal_range": { "min": 0, "max": 100 }
    },
    {
      "slot": 17, "group": "C", "name": "sp_product_mode",
      "display_name": "Productmodus", "datatype": "String", "unit": "",
      "writable": true, "sampling_class": "onchange", "deadband": null,
      "source": "physics.product_mode"
    },

    {
      "slot": 18, "group": "D", "name": "valve_pos_pct",
      "display_name": "Klepstand", "datatype": "Double", "unit": "%",
      "writable": false, "sampling_class": "normal", "deadband": 1.0,
      "source": "health.valve_pos_pct",
      "normal_range": { "min": 0, "max": 100 }
    },
    {
      "slot": 19, "group": "D", "name": "drive_out_pct",
      "display_name": "Aandrijfsturing", "datatype": "Double", "unit": "%",
      "writable": false, "sampling_class": "normal", "deadband": 1.0,
      "source": "health.drive_out_pct",
      "normal_range": { "min": 0, "max": 100 }
    },

    {
      "slot": 20, "group": "E", "name": "units_total",
      "display_name": "Eenheden totaal", "datatype": "Int64", "unit": "st",
      "writable": false, "sampling_class": "slow", "deadband": 0,
      "source": "health.units_total", "monotonic": true
    },
    {
      "slot": 21, "group": "E", "name": "reject_total",
      "display_name": "Afkeur totaal", "datatype": "Int64", "unit": "st",
      "writable": false, "sampling_class": "slow", "deadband": 0,
      "source": "health.reject_total", "monotonic": true
    },
    {
      "slot": 22, "group": "E", "name": "mass_total_kg",
      "display_name": "Massa totaal", "datatype": "Double", "unit": "kg",
      "writable": false, "sampling_class": "slow", "deadband": 1.0,
      "source": "health.mass_total_kg", "monotonic": true
    },
    {
      "slot": 23, "group": "E", "name": "runtime_hours",
      "display_name": "Draaiuren", "datatype": "Double", "unit": "h",
      "writable": false, "sampling_class": "slow", "deadband": 0.01,
      "source": "health.runtime_hours", "monotonic": true
    },

    {
      "slot": 24, "group": "F", "name": "motor_current_A",
      "display_name": "Motorstroom", "datatype": "Double", "unit": "A",
      "writable": false, "sampling_class": "normal", "deadband": 0.2,
      "source": "health.motor_current_a",
      "normal_range": { "min": 0, "max": 80 },
      "cbm_note": "Stijgt bij f8 (verstopping/vervuiling) en bij f13 (motorslip). Samen met units_total geeft dit specifiek verbruik per eenheid."
    },
    {
      "slot": 25, "group": "F", "name": "vibration_mm_s",
      "display_name": "Trilling", "datatype": "Double", "unit": "mm/s",
      "writable": false, "sampling_class": "normal", "deadband": 0.1,
      "source": "health.vibration_mm_s",
      "normal_range": { "min": 0, "max": 11.2 },
      "cbm_note": "ISO 10816-zone-grenzen: 2.8 goed, 7.1 acceptabel, 11.2 alarm. Loopt op met lagerslijtage en met f8."
    },
    {
      "slot": 26, "group": "F", "name": "bearing_temp_C",
      "display_name": "Lagertemperatuur", "datatype": "Double", "unit": "°C",
      "writable": false, "sampling_class": "slow", "deadband": 0.5,
      "source": "health.bearing_temp_c",
      "normal_range": { "min": 0, "max": 95 },
      "cbm_note": "Eerste-orde naijling op motorstroom. Loopt achter op trilling, en dat is het punt: trilling waarschuwt eerder."
    },
    {
      "slot": 27, "group": "F", "name": "energy_kWh",
      "display_name": "Energie cumulatief", "datatype": "Double", "unit": "kWh",
      "writable": false, "sampling_class": "slow", "deadband": 0.05,
      "source": "health.energy_kwh", "monotonic": true,
      "cbm_note": "energy_kWh / units_total is energie per pak. De overtuigendste kosten-KPI in zuivel, en hij komt hier gratis uit."
    },
    {
      "slot": 28, "group": "F", "name": "cycles_since_cip",
      "display_name": "Cycli sinds CIP", "datatype": "Int32", "unit": "st",
      "writable": false, "sampling_class": "slow", "deadband": 0,
      "source": "health.cycles_since_cip",
      "cbm_note": "Reactieve tegenhanger van de heat-up-trend-alert die al in batch-engine/vla/equipment.py zit."
    },
    {
      "slot": 29, "group": "F", "name": "hours_since_service",
      "display_name": "Uren sinds onderhoud", "datatype": "Double", "unit": "h",
      "writable": false, "sampling_class": "slow", "deadband": 0.5,
      "source": "health.hours_since_service"
    },

    {
      "slot": 30, "group": "G", "name": "alarm_word",
      "display_name": "Alarmwoord", "datatype": "Int32", "unit": "",
      "writable": false, "sampling_class": "onchange", "deadband": 0,
      "source": "health.alarm_word",
      "bitfield": {
        "0": "PV onder ondergrens",
        "1": "PV boven bovengrens",
        "2": "aandrijffout",
        "3": "sensorfout",
        "4": "CIP nodig",
        "5": "interlock actief",
        "6": "kwaliteit slecht",
        "7": "invoer stale"
      }
    }
  ],

  "expected_counts": {
    "slots_total": 30,
    "by_group": { "A": 5, "B": 8, "C": 4, "D": 2, "E": 4, "F": 6, "G": 1 },
    "by_sampling_class": { "fast": 4, "normal": 9, "slow": 8, "onchange": 9 }
  },

  "rate_budget_per_machine_msg_s": 6.07,
  "rate_budget_note": "4/1s + 9/5s + 8/30s + ~9 onchange a ~0.05/s = ~6.1 msg/s per machine, dus ~73 msg/s over 12 machines, plus ~6 msg/s aan .Q-companions. Zie het VPS-hoofdstuk van het plan; naief 1 Hz op alle 360 tags past niet op 2 vCPU."
}
